# Thinker profile config snippet — merge into ~/.hermes/profiles/thinker/config.yaml
model:
  provider: openrouter
  default: openai/gpt-5.4
  reasoning_effort: high

plugins:
  entries:
    cortex:
      enabled: true
      settings:
        daemon_profile: herald
        shared_state_dir: ~/.hermes/cortex
        decision_backend: http_decision
        decision_url: https://api.typesafe.ai/v1/systemone
        decision_model: jev-latest
        decision_format: systemone
        decision_timeout_s: 2.0
        allowed_log_roots:
          - /var/log
          - /opt/data/logs
